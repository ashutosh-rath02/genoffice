{
  "name": "@threadnote/shell",
  "productName": "Threadnote Office",
  "version": "0.10.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Threadnote desktop office suite for project documents",
  "main": "out/main/index.js",
  "desktopName": "threadnoteoffice.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@threadnote/agent-core": "*",
    "@threadnote/ai-provider": "*",
    "@threadnote/ai-search": "*",
    "@threadnote/docs": "*",
    "@threadnote/docx-engine": "*",
    "@threadnote/electron-utils": "*",
    "@threadnote/cli": "*",
    "@threadnote/i18n": "*",
    "@threadnote/pipelines": "*",
    "@threadnote/pptx-engine": "*",
    "@threadnote/pptx-render": "*",
    "@threadnote/sheets": "*",
    "@threadnote/slides": "*",
    "@threadnote/ui": "*",
    "@threadnote/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "Threadnote"
}
